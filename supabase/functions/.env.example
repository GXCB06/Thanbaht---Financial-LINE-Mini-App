# Secrets for the LINE webhook. Copy to supabase/functions/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.

# LINE Developers Console → your Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Mini App channel → LIFF ID (same value as VITE_LIFF_ID in the app's .env)
LIFF_ID=

# Google AI Studio API key, used to read slips and transcribe voice notes
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash. Use any model your key can access.
GEMINI_MODEL=

# The daily-digest function's own secret: any long random string (e.g. `openssl rand -hex 32`).
# The pg_cron job sends it back as a bearer token, so only that job can trigger a digest run.
# Set the SAME value in Vault as `digest_cron_secret` — see the migration's comment.
DIGEST_CRON_SECRET=

# The flush-stale-batches function's own secret, same idea as DIGEST_CRON_SECRET above.
# Set the SAME value in Vault as `flush_batches_cron_secret` — see that migration's comment.
FLUSH_BATCHES_CRON_SECRET=
